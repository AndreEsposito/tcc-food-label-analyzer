#:kivy 2.0
#:import utils kivy.utils

<HomeScreen>:

    FloatLayout:

        BoxLayout:
            orientation: "vertical"
            spacing: "8dp"
            size_hint: None, None
            width: min(root.width - dp(64), dp(520))
            height: self.minimum_height
            pos_hint: {"center_x": 0.5, "center_y": 0.64}

            Image:
                source: "assets/images/logo.png"
                size_hint: None, None
                size: "112dp", "112dp"
                pos_hint: {"center_x": 0.5}
                fit_mode: "contain"

            Label:
                text: "Rótulo [color=#FF6B00]Inteligente[/color]"
                markup: True
                font_size: "34sp"
                bold: True
                color: utils.get_color_from_hex("#3F3F3F")
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: "center"
                valign: "middle"

            Label:
                text: "Entenda o que você consome.\nFaça escolhas mais conscientes."
                font_size: "17sp"
                color: utils.get_color_from_hex("#4A4A4A")
                line_height: 1.18
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: "center"
                valign: "middle"

        # Botões centralizados na parte inferior
        BoxLayout:
            orientation: "vertical"
            spacing: "16dp"
            padding: "32dp", 0
            size_hint: 1, None
            height: "160dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.28}

            # Botão primário — Capturar rótulo
            Button:
                text: "Capturar rótulo"
                font_size: "17sp"
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: "62dp"
                background_color: 0, 0, 0, 0
                on_release: app.root.current = "camera"
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex("#E85F00") if self.state == "down" else utils.get_color_from_hex("#FF6B00")
                    RoundedRectangle:
                        pos: self.x, self.y - (dp(2) if self.state == "down" else 0)
                        size: self.size
                        radius: [dp(18)]

            # Botão secundário — Selecionar da galeria
            Button:
                text: "Selecionar da galeria"
                font_size: "17sp"
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: "62dp"
                background_color: 0, 0, 0, 0
                on_release: root.abrir_galeria()
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex("#F07A12") if self.state == "down" else utils.get_color_from_hex("#FF8C2A")
                    RoundedRectangle:
                        pos: self.x, self.y - (dp(2) if self.state == "down" else 0)
                        size: self.size
                        radius: [dp(18)]
